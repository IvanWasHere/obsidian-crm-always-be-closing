{
	"name": "always-be-closing",
	"version": "0.0.1",
	"description": "A personal CRM for Obsidian: contacts, companies, deals and interactions stored as Markdown notes.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"setup:vault": "node scripts/setup-test-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"crm"
	],
	"license": "0-BSD",
	"dependencies": {
		"jspdf": "^4.2.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"jsdom": "^29.1.1",
		"obsidian": "^1.13.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^4.1.11"
	}
}
